---
import sources from '../data/sources.json';
const { ids = [] } = Astro.props;
const map = new Map((sources as any[]).map(s => [s.id, s]));
// Several citation IDs in the source research map to the same document.
// Deduplicate by URL so the register reads as a list of sources, not repeats.
const seen = new Set<string>();
const used = ids
  .map((n: number) => map.get(n))
  .filter(Boolean)
  .filter((s: any) => { if (seen.has(s.url)) return false; seen.add(s.url); return true; });
---
{used.length > 0 && (
  <section class="sources" id="sources">
    <h2>Sources</h2>
    <ol>
      {used.map((s: any) => (
        <li id={`s${s.id}`}>
          {s.title}. <a href={s.url} rel="nofollow noopener" target="_blank">{new URL(s.url).hostname}</a>
        </li>
      ))}
    </ol>
  </section>
)}
