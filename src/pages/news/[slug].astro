---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import site from '../../site.config.json';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news', (e: any) => !e.data.draft);
  return posts.map((entry: any) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
const url = new URL(`/news/${entry.slug}/`, site.domain).href;
const schema = [{
  "@type": "NewsArticle", "@id": `${url}#article`,
  headline: d.title, description: d.description,
  datePublished: d.date, dateModified: d.date, inLanguage: "en-AU",
  publisher: { "@id": `${site.domain}/#publisher` }
}];
---
<BaseLayout title={`${d.title} | ${site.siteName}`} description={d.description} canonical={url} schema={schema}>
  <div class="wrap" style="padding-top:28px;padding-bottom:56px;max-width:820px">
    <Breadcrumbs trail={[{label:'Home',href:'/'},{label:'News',href:'/news/'},{label:d.title}]} />
    <h1>{d.title}</h1>
    <div class="stamp"><span><b>Published</b> {d.date}</span></div>
    <Content />
  </div>
</BaseLayout>
