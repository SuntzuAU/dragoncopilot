---
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../site.config.json';
import { getCollection } from 'astro:content';
const posts = (await getCollection('news', (e: any) => !e.data.draft))
  .sort((a: any, b: any) => b.data.date.localeCompare(a.data.date));
---
<BaseLayout title={`News and analysis | ${site.siteName}`} description="Dated analysis of Microsoft Dragon Copilot changes affecting Australian healthcare.">
  <div class="wrap" style="padding-top:28px;padding-bottom:56px;max-width:900px">
    <h1>News and analysis</h1>
    {posts.length === 0 && <p style="color:var(--muted)">No articles published yet.</p>}
    <ul>{posts.map((p: any) => (
      <li><a href={`/news/${p.slug}/`}>{p.data.title}</a> — <span style="color:var(--muted)">{p.data.date}</span></li>
    ))}</ul>
  </div>
</BaseLayout>
