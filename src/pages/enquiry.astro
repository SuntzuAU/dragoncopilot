---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnswerBlock from '../components/AnswerBlock.astro';
import ACForm from '../components/ACForm.astro';
import site from '../site.config.json';
const c = site.colours;
const formReady = site.form.formId !== 'CHANGE_ME';
---
<BaseLayout title={`Request current Dragon Copilot information | ${site.siteName}`}
  description="Ask Voice Recognition Australia for current Dragon Copilot and Dragon Medical One availability, licensing options and EMR integration information for your organisation.">
  <div class="wrap" style="padding-top:28px;padding-bottom:56px;max-width:900px">
    <h1>How do I get current Dragon Copilot information for my organisation?</h1>
    <AnswerBlock>
      Ask Voice Recognition Australia. Availability, licensing terms and integration support for Dragon Copilot
      change regularly and are not all published. Tell us your clinical software, your user numbers and your
      jurisdiction, and we will confirm the current position rather than the position at the date on this page.
    </AnswerBlock>

    <h2>What to include</h2>
    <ul>
      <li>Your organisation and sector — general practice, specialist, hospital, or government health service</li>
      <li>Your clinical or practice management system</li>
      <li>Approximate number of clinicians</li>
      <li>Whether you use Dragon Medical One today</li>
      <li>Any data residency or procurement requirements</li>
    </ul>

    <div style={`background:${c.primaryDark};border-radius:8px;padding:26px;margin-top:28px`}>
      {formReady ? <ACForm /> : (
        <div style="color:#fff">
          <div style="font-weight:700;font-size:20px;margin-bottom:6px">Get in touch</div>
          <p style="font-size:15px;opacity:.85;margin:0 0 18px;max-width:none">
            Voice Recognition Australia has supplied and supported Dragon speech recognition to Australian
            healthcare for over two decades. Contact the team for current availability, licensing options
            and integration advice for your clinical system.
          </p>
          <a href="https://www.voicerecognition.com.au"
             style={`display:inline-block;background:#fff;color:${c.primaryDark};font-weight:600;padding:12px 22px;border-radius:4px;text-decoration:none`}>
            Contact Voice Recognition Australia
          </a>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
