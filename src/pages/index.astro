---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnswerBlock from '../components/AnswerBlock.astro';
import site from '../site.config.json';
import { getCollection } from 'astro:content';
const docs = await getCollection('docs', (e: any) => !e.data.draft);
---
<BaseLayout title={`${site.siteName} — Microsoft Dragon Copilot reference guide`}
  description="An independent Australian reference guide to Microsoft Dragon Copilot and Dragon Medical One: licensing options, EMR integration, data residency, consent and the published evidence.">
  <div class="wrap" style="padding-top:32px;padding-bottom:56px">
    <h1>Microsoft Dragon Copilot, explained for Australian healthcare</h1>
    <AnswerBlock question="What is this site?">
      This is an independent Australian reference guide to Microsoft Dragon Copilot and Dragon Medical One,
      published by {site.publisher.name}, an authorised Australian reseller. Every claim is dated and
      sourced to primary documentation, so you can see what Microsoft actually says — and what is still unresolved.
    </AnswerBlock>

    <div class="hubgrid">
      {site.hubs.map((h: any) => (
        <div class="hubcard">
          <h3><a href={`/${h.slug}/`}>{h.title}</a></h3>
          <p>{h.blurb}</p>
        </div>
      ))}
      <div class="hubcard">
        <h3><a href="/emr/">Australian EMR integration</a></h3>
        <p>System-by-system integration status across Australian clinical and practice management software.</p>
      </div>
    </div>

    {docs.length > 0 && (
      <>
        <h2>All pages</h2>
        <ul>{docs.sort((a:any,b:any)=>a.data.order-b.data.order).map((d: any) => (
          <li><a href={`/${d.slug}/`}>{d.data.question}</a></li>
        ))}</ul>
      </>
    )}
  </div>
</BaseLayout>
