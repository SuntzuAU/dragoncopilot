---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnswerBlock from '../../components/AnswerBlock.astro';
import ACForm from '../../components/ACForm.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SourceList from '../../components/SourceList.astro';
import site from '../../site.config.json';
import { getCollection } from 'astro:content';
const c = site.colours;

export async function getStaticPaths() {
  const emrs = await getCollection('emr');
  return emrs.map((e: any) => ({ params: { slug: e.data.slug }, props: { emr: e.data } }));
}
const { emr } = Astro.props;
const url = new URL(`/emr/${emr.slug}/`, site.domain).href;
const question = `Does Dragon work with ${emr.name}?`;
const answer = emr.status === 'available'
  ? `Dragon Medical One: yes, available in Australia today. ${emr.note} Dragon Copilot is coming to the Australian market and its position for ${emr.name} will be confirmed on release.`
  : `Dragon Medical One: not confirmed yet. ${emr.note} Dragon Copilot is coming to the Australian market and its position for ${emr.name} will be confirmed on release.`;

const schema = [{
  "@type": "FAQPage", "@id": `${url}#faq`,
  mainEntity: [{ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } }]
}];
---
<BaseLayout title={`${question} | ${site.siteName}`}
  description={`Dragon Copilot and Dragon Medical One status for ${emr.name} (${emr.vendor}) in Australia.`}
  canonical={url} schema={schema}>
  <div class="wrap" style="padding-top:28px;padding-bottom:56px;max-width:900px">
    <Breadcrumbs trail={[{label:'Home',href:'/'},{label:'Clinical software',href:'/emr/'},{label:emr.name}]} />
    <h1>{question}</h1>

    <div class="stamp">
      <span>
        <b>Dragon Medical One</b>
        <span style={`display:inline-block;font-weight:700;padding:2px 9px;border-radius:3px;margin-left:4px;background:${emr.status === 'available' ? '#E3F1EA' : c.surfaceAlt};color:${emr.status === 'available' ? c.ok : c.muted}`}>
          {emr.status === 'available' ? 'Available now' : 'Pending'}
        </span>
      </span>
      <span>
        <b>Dragon Copilot</b>
        <span style={`display:inline-block;font-weight:700;padding:2px 9px;border-radius:3px;margin-left:4px;background:${c.primaryLight};color:${c.primaryDark}`}>
          On Australian release
        </span>
      </span>
      <span><b>Vendor</b> {emr.vendor}</span>
    </div>

    <AnswerBlock>{answer}</AnswerBlock>

    <h2>About {emr.name}</h2>
    <p>{emr.marketNote}</p>

    <h2>Dragon Medical One with {emr.name}</h2>
    {emr.status === 'available' ? (
      <p>Dragon Medical One is in use with {emr.name} in Australia. Exactly how it behaves depends on your version,
      your deployment and whether you are running locally or through Citrix or remote desktop — so the
      practical step is to have Voice Recognition Australia confirm the configuration for your site before
      you roll it out across a team.</p>
    ) : (
      <p>We have not confirmed a documented Dragon Medical One integration for {emr.name}, and we would rather say that
      than guess. In many cases dictation still works through Dragon's dictation window, which you then paste
      from — it is just not the same thing as text landing directly in the clinical field. Voice Recognition
      Australia can test and confirm the position for your setup.</p>
    )}

    <h2>Dragon Copilot and {emr.name}</h2>
    <p>Dragon Copilot is coming to the Australian market. Microsoft has not announced an Australian release
    date, and integration detail for Australian clinical systems will be confirmed as it is released.
    Register your interest below and we will contact you with the position for {emr.name} when it lands.</p>

    <SourceList ids={emr.sources} />

    <section style={`background:${c.primaryDark};border-radius:8px;padding:28px;margin-top:40px`}>
      <div style="max-width:520px">
        <h2 style="color:#fff;margin-top:0">Ask about {emr.name}</h2>
        <p style="color:#fff;opacity:.85;max-width:none">Tell us your setup and how many clinicians you have.
        We will confirm what works today and contact you when Dragon Copilot reaches Australia.</p>
        <ACForm />
      </div>
    </section>
  </div>
</BaseLayout>
