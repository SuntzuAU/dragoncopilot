---
import site from '../site.config.json';
import '../styles/global.css';

const {
  title, description, canonical,
  schema = [],           // extra JSON-LD nodes
} = Astro.props;

const url = canonical ?? new URL(Astro.url.pathname, site.domain).href;

const graph = [
  {
    "@type": "Organization",
    "@id": `${site.domain}/#publisher`,
    name: site.publisher.name,
    url: site.publisher.url,
    description: `${site.publisher.role}, trading ${site.publisher.yearsTrading} years.`,
    areaServed: "AU"
  },
  {
    "@type": "WebSite",
    "@id": `${site.domain}/#website`,
    url: site.domain,
    name: site.siteName,
    inLanguage: "en-AU",
    publisher: { "@id": `${site.domain}/#publisher` }
  },
  ...schema
];
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <!-- max-snippet:-1 matters: it removes the snippet-length cap that otherwise
       truncates the answer block before an engine can lift the whole answer. -->
  <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />
  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:locale" content="en_AU" />
  <meta property="og:site_name" content={site.siteName} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })} />
  {site.googleAnalyticsId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAnalyticsId}`}></script>
      <script define:vars={{ gaId: site.googleAnalyticsId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    </>
  )}
</head>
<body>
  <header class="masthead">
    <div class="masthead__bar">
      <a class="masthead__name" href="/" aria-label={`${site.siteName} home`}>
        <img src="/logo.png" alt={`Microsoft Dragon Copilot — presented in Australia by ${site.publisher.name}`} width="1200" height="208" />
      </a>
      <nav class="masthead__nav" aria-label="Primary">
        {site.hubs.map((h: any) => <a href={`/${h.slug}/`}>{h.title}</a>)}
        <a href="/emr/">EMR integration</a>
        <a href="/sector/">Government & hospitals</a>
        <a href="/enquiry/">Enquiry</a>
      </nav>
    </div>
    <div class="masthead__rule"></div>
  </header>

  <slot />

  <footer class="foot">
    <div class="wrap">
      <p><strong>{site.publisher.name}</strong> — {site.tagline}.</p>
      <p class="legal">
        {site.legal.resellerLine} {site.legal.disclaimer} Last reviewed {new Date(site.lastUpdated).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}.
      </p>
    </div>
  </footer>
</body>
</html>
